    "@langchain/core": "^1.2.9",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/openai": "^1.5.11",
    "@langchain/textsplitters": "^1.0.1",
    "@vscode/ripgrep": "^1.18.0",
    "ansi-escapes": "^7.3.0",
    "chalk": "^5.6.2",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "mammoth": "^1.12.2",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "minimatch": "^10.2.6",
    "sharp": "^0.35.4",
    "string-width": "^8.2.2",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "vitest": "^5.0.1"
