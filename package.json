{
  "name": "ai-frontend",
  "version": "1.0.0",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "smoke": "node test/smoke.mjs",
    "test:input": "node test/input-flow.mjs",
    "test:overlay": "node test/design-overlay.mjs",
    "test:unit": "vitest run",
    "verify:tui": "node test/tui-live-select.mjs",
    "verify:crew": "node test/crew-live.mjs",
    "verify:front": "node test/front-live.mjs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "files": [
    "image/README/调试代码.png",
    "image/README/设计图生成.png",
    "image/README/终端对话界面.png",
    "python-fastapi/**/*.py",
    "!python-fastapi/.venv/**",
    "python-fastapi/config/**/*",
    "python-fastapi/requirements.txt",
    "skills/**/*",
    "src/**/*",
    "app.js",
    "config.js",
    "README.md"
  ],
  "bin": {
    "front": "./app.js"
  },
  "keywords": [
    "cli",
    "ai",
    "ui-design",
    "frontend"
  ],
  "author": "LBB",
